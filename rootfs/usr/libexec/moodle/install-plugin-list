#!/bin/sh
set -eu
set -f
# Description: install Moodle plugin(s) from the Moodle Marketplace by component name.
#
# The Marketplace API is used for both version discovery and ZIP download. An optional
# Docker BuildKit secret named MOODLE_MARKETPLACE_TOKEN is read from
# /run/secrets/MOODLE_MARKETPLACE_TOKEN for paid plugins. The token is never copied into
# the image, written to the source tree, passed on the command line, or printed.

MARKETPLACE_PLUGIN_DOWNLOADER=/usr/libexec/moodle/marketplace-plugin-download.php

usage() {
    cat 1>&2 <<EOF2
Script to install Moodle plugin(s) by component name (ex. 'mod_jitsi').
It requires PHP cli, PHP cURL and unzip.

ENVIRONMENT VARS:
MOODLE_APP                  path to Moodle code
MOODLE_PLUGIN_LIST          plugin list separated by comma or space
MOODLE_RELEASE              Moodle release (ex: '5.0'). Default is read from version.php
MOODLE_MARKETPLACE_TOKEN_FILE
                            optional path to the Marketplace API token secret
                            (default: /run/secrets/MOODLE_MARKETPLACE_TOKEN)

USAGE:
    install-plugin-list [OPTIONS]

OPTIONS:
  -f            force installation of the latest Marketplace version regardless of
                Moodle compatibility or maturity
  -m            minimum plugin maturity level (50=alpha, 100=beta, 150=rc, 200=stable)
  -p            plugin list, separated by comma, to be installed
EOF2
}

get_moodle_core_version() {
    local version_file="${MOODLE_APP:-/var/www/html}/version.php"

    if [ ! -r "$version_file" ]; then
        >&2 echo "ERROR: Unable to determine Moodle core version: ${version_file} is not readable."
        exit 1
    fi

    php -r 'define("MOODLE_INTERNAL", true); define("MATURITY_ALPHA", 50); define("MATURITY_BETA", 100); define("MATURITY_RC", 150); define("MATURITY_STABLE", 200); define("ANY_VERSION", "any"); require $argv[1]; echo $version;' "$version_file"
}

install_path() {
    local plugin_type=$1
    local plugin_name=$2
    local plugin_dir

    # Keep this map aligned with Moodle's official plugin-type list:
    # https://moodledev.io/docs/5.3/apis/plugintypes
    # Paths are Moodle-root-relative; plugin type names are not always enough to
    # derive their directory (many plugin types are nested under their owning module).
    case "$plugin_type" in
        tinymce) plugin_dir='lib/editor/tinymce/plugins' ;;
        tiny) plugin_dir='lib/editor/tiny/plugins' ;;
        workshopallocation) plugin_dir='mod/workshop/allocation' ;;
        atto) plugin_dir='lib/editor/atto/plugins' ;;
        availability) plugin_dir='availability/condition' ;;
        assignsubmission) plugin_dir='mod/assign/submission' ;;
        logstore) plugin_dir='admin/tool/log/store' ;;
        quizaccess) plugin_dir='mod/quiz/accessrule' ;;
        assignment) plugin_dir='mod/assignment/type' ;;
        assignfeedback) plugin_dir='mod/assign/feedback' ;;
        gradingform) plugin_dir='grade/grading/form' ;;
        qbehaviour) plugin_dir='question/behaviour' ;;
        profilefield) plugin_dir='user/profile/field' ;;
        workshopform) plugin_dir='mod/workshop/form' ;;
        workshopeval) plugin_dir='mod/workshop/eval' ;;
        scormreport) plugin_dir='mod/scorm/report' ;;
        fileconverter) plugin_dir='files/converter' ;;
        qformat) plugin_dir='question/format' ;;
        quiz) plugin_dir='mod/quiz/report' ;;
        ltiservice) plugin_dir='mod/lti/service' ;;
        datapreset) plugin_dir='mod/data/preset' ;;
        ltisource) plugin_dir='mod/lti/source' ;;
        datafield) plugin_dir='mod/data/field' ;;
        message) plugin_dir='message/output' ;;
        booktool) plugin_dir='mod/book/tool' ;;
        calendartype) plugin_dir='calendar/type' ;;
        format) plugin_dir='course/format' ;;
        coursereport) plugin_dir='course/report' ;;
        mlbackend) plugin_dir='lib/mlbackend' ;;
        search) plugin_dir='search/engine' ;;
        antivirus) plugin_dir='lib/antivirus' ;;
        qtype) plugin_dir='question/type' ;;
        qbank) plugin_dir='question/bank' ;;
        contenttype) plugin_dir='contentbank/contenttype' ;;
        h5plib) plugin_dir='h5p/h5plib' ;;
        media) plugin_dir='media/player' ;;
        cachestore) plugin_dir='cache/stores' ;;
        gradereport) plugin_dir='grade/report' ;;
        gradeimport) plugin_dir='grade/import' ;;
        gradeexport) plugin_dir='grade/export' ;;
        mnetservice) plugin_dir='mnet/service' ;;
        cachelock) plugin_dir='cache/locks' ;;
        plagiarism) plugin_dir='plagiarism' ;;
        repository) plugin_dir='repository' ;;
        tool) plugin_dir='admin/tool' ;;
        editor) plugin_dir='lib/editor' ;;
        dataformat) plugin_dir='dataformat' ;;
        webservice) plugin_dir='webservice' ;;
        portfolio) plugin_dir='portfolio' ;;
        filter) plugin_dir='filter' ;;
        report) plugin_dir='report' ;;
        block) plugin_dir='blocks' ;;
        local) plugin_dir='local' ;;
        enrol) plugin_dir='enrol' ;;
        theme) plugin_dir='theme' ;;
        auth) plugin_dir='auth' ;;
        mod) plugin_dir='mod' ;;
        *)
            >&2 echo "ERROR: ${plugin_type} is not a valid Moodle plugin type."
            exit 1
            ;;
    esac
    printf '%s/%s/%s\n' "${MOODLE_APP:-/var/www/html}" "$plugin_dir" "$plugin_name"
}

install_plugin() {
    local component=$1
    local plugin_type plugin_name destination tmp_parent zip_file extracted_root

    plugin_type=${component%%_*}
    plugin_name=${component#*_}
    if [ "$plugin_type" = "$component" ] || [ -z "$plugin_name" ]; then
        >&2 echo "ERROR: Invalid Moodle plugin component: ${component}"
        exit 1
    fi

    destination=$(install_path "$plugin_type" "$plugin_name")
    tmp_parent="/tmp/moodle-plugins/${component}"
    zip_file="${tmp_parent}/${component}.zip"
    mkdir -p "$tmp_parent"

    echo "Installing plugin: ${component}..."
    echo "Downloading from Moodle Marketplace..."
    rm -f "$zip_file"
    php "$MARKETPLACE_PLUGIN_DOWNLOADER" \
        "$component" \
        "${MOODLE_RELEASE}" \
        "${script_moodle_plugin_maturity}" \
        "${script_moodle_plugin_force}" \
        "$zip_file" \
        "${core_version}"

    if [ ! -s "$zip_file" ]; then
        >&2 echo "ERROR: Moodle Marketplace returned an empty plugin archive for ${component}."
        exit 1
    fi
    if ! unzip -tq "$zip_file" >/dev/null; then
        >&2 echo "ERROR: Moodle Marketplace returned an invalid ZIP archive for ${component}."
        exit 1
    fi

    rm -rf "${tmp_parent}/extracted"
    mkdir -p "${tmp_parent}/extracted"
    unzip -q "$zip_file" -d "${tmp_parent}/extracted"
    extracted_root=$(find "${tmp_parent}/extracted" -mindepth 1 -maxdepth 1 -type d -print -quit)
    if [ -z "$extracted_root" ] || [ ! -f "${extracted_root}/version.php" ]; then
        >&2 echo "ERROR: ${component} archive does not contain a valid top-level version.php."
        exit 1
    fi
    if ! grep -Eq "[\\$]plugin[[:space:]]*->[[:space:]]*component[[:space:]]*=[[:space:]]*['\"]${component}['\"]" "${extracted_root}/version.php"; then
        >&2 echo "ERROR: ${component} archive version.php does not declare component ${component}."
        exit 1
    fi

    if [ -d "$destination" ]; then
        local backup_dir="${tmp_parent}/backup"
        rm -rf "$backup_dir"
        mkdir -p "$backup_dir"
        echo "Destination directory already exists: ${destination}"
        echo "Moving it to: ${backup_dir}"
        mv "$destination" "$backup_dir/"
    fi

    mkdir -p "$(dirname "$destination")"
    echo "Installing to: ${destination}"
    mv "$extracted_root" "$destination"
}

moodle_plugin_list=${MOODLE_PLUGIN_LIST:-}
script_moodle_plugin_force=
script_moodle_plugin_maturity=0

while getopts ":fp:m:" opt; do
    case ${opt} in
        f) script_moodle_plugin_force="true" ;;
        p) moodle_plugin_list="${OPTARG}" ;;
        m) script_moodle_plugin_maturity="${OPTARG}" ;;
        \?) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ "$OPTIND" -eq 1 ]; then
    printf 'No check. Use an option:\n\n'
    usage
    exit 0
fi

if [ -z "${moodle_plugin_list}" ]; then
    >&2 echo "ERROR: No plugin list set."
    usage
    exit 1
fi

if [ -z "${MOODLE_RELEASE:-}" ]; then
    # Derive the release from the Moodle stable branch (e.g. MOODLE_500_STABLE -> 5.0).
    # This avoids depending on version.php after the source cleanup step.
    case "${MOODLE_GIT_BRANCH:-}" in
        MOODLE_[0-9][0-9][0-9]_STABLE)
            branch_version=${MOODLE_GIT_BRANCH#MOODLE_}
            branch_version=${branch_version%_STABLE}
            moodle_major="${branch_version%??}"
            moodle_minor="${branch_version#?}"
            case "$moodle_minor" in
                0*) moodle_minor=${moodle_minor#0} ;;
            esac
            [ -n "$moodle_minor" ] || moodle_minor=0
            MOODLE_RELEASE="${moodle_major}.${moodle_minor}"
            ;;
    esac
fi
if [ -z "${MOODLE_RELEASE:-}" ]; then
    >&2 echo "ERROR: Unable to determine Moodle release."
    exit 1
fi
export MOODLE_RELEASE
core_version=$(get_moodle_core_version)
echo "Moodle core version: ${core_version}"

plugin_list=$(printf '%s' "$moodle_plugin_list" | tr ', ' ' ')
for plugin in $plugin_list; do
    [ -n "$plugin" ] && install_plugin "$plugin"
done
