install_plugin_from_url() {
    url="$1"
    echo "Installing plugin from URL: ${url}..."
    tmp_parent="/tmp/moodle-plugins/url-$(echo "${url}" | md5sum | cut -d ' ' -f1)"
    rm -rf "${tmp_parent}"
    mkdir -p "${tmp_parent}"
    zip="${tmp_parent}/plugin.zip"
    if ! download_zip "${url}" "${zip}" || ! is_zip "${zip}"; then
        echo "ERROR: Downloaded file is not a valid Moodle plugin ZIP: ${url}" >&2
        exit 1
    fi
    place_plugin "${zip}" "" "" "${tmp_parent}/extract"
}

install_plugin() {
    component="$1"
    case "${component}" in
        http://*|https://*)
            install_plugin_from_url "${component}"
            return
            ;;
    esac

    export script_moodle_plugin_component_name="${component}"
    echo "Installing plugin: ${component}..."

    downloadurl=""
    downloadmd5=""
    installpath=""
    sourceurl=""
    vcstag=""
    if ! plugin_meta=$(get_plugin_meta); then
        exit 1
    fi
    while IFS='=' read -r key value; do
        case "${key}" in
            downloadurl) downloadurl="${value}" ;;
            downloadmd5) downloadmd5="${value}" ;;
            installpath) installpath="${value}" ;;
            source) sourceurl="${value}" ;;
            vcstag) vcstag="${value}" ;;
        esac
    done <<< "${plugin_meta}"

    if [ -z "${installpath}" ]; then
        echo "ERROR: No install path for [${component}]." >&2
        exit 1
    fi

    tmp_key="${downloadmd5:-${component}}"
    tmp_parent="/tmp/moodle-plugins/${tmp_key}"
    rm -rf "${tmp_parent}"
    mkdir -p "${tmp_parent}"
    zip="${tmp_parent}/${component}.zip"

    downloaded=false
    if [ -n "${downloadurl}" ]; then
        echo "Downloading plugin zip: ${component}"
        if download_zip "${downloadurl}" "${zip}" && is_zip "${zip}"; then
            downloaded=true
            if [ -n "${downloadmd5}" ]; then
                md5_from_file=$(md5sum "${zip}" | cut -d " " -f1)
                if [ "${md5_from_file}" != "${downloadmd5}" ]; then
                    echo "WARNING: MD5 does not match (${md5_from_file} != ${downloadmd5}); ZIP is valid, continuing."
                fi
            fi
        else
            echo "Marketplace/plugin ZIP download failed for [${component}]; trying public source archive."
            rm -f "${zip}"
        fi
    fi

    if [ "${downloaded}" != true ]; then
        archive_url=""
        if archive_url=$(git_archive_url "${sourceurl}" "${vcstag}"); then
            echo "Downloading plugin zip: ${component}"
            if ! download_zip "${archive_url}" "${zip}" || ! is_zip "${zip}"; then
                echo "ERROR: Unable to download a valid plugin ZIP for [${component}]." >&2
                exit 1
            fi
        else
            echo "ERROR: No plugin ZIP or public source archive for [${component}]." >&2
            echo "Provide an HTTPS ZIP URL in MOODLE_PLUGIN_LIST if the plugin is not on Moodle Marketplace." >&2
            exit 1
        fi
    fi

    place_plugin "${zip}" "${component}" "${installpath}" "${tmp_parent}/extract"
}

