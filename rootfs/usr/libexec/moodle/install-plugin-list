#!/bin/bash -eu
# Description: install moodle plugin(s) by component name
# Forked from https://github.com/krestomatio/container_builder/blob/master/.ansible-ci/files/templated_contexts/moodle_php-fpm/conf/usr/libexec/moodle/install-plugin-list
# - Corrected typo
# - Adjusted some commands to make code smell happy
# - Added plugin name when error in PHP function install_path
# - Resolve ZIPs from Moodle Marketplace (pluginfo + unauthenticated download API)
#   and fall back to the plugin's public VCS archive when the ZIP is unavailable
# TODO: port to /bin/sh

INSTALLER_USER_AGENT='Mozilla/5.0 (compatible; alpine-moodle/1.0; +https://github.com/jimsihk/alpine-moodle)'

usage() {
    cat 1>&2 <<EOF
Script to install moodle plugin(s) by component name (ex. 'mod_jitsi').
It requires PHP cli, PHP json, unzip

ENVIRONMENT VARS:
MOODLE_APP                  path to moodle code
MOODLE_API_PLUGIN_INFO      url to plugin info json
MOODLE_PLUGIN_LIST          plugin list separated by space or comma
MOODLE_RELEASE              Moodle release (ex: '3.9'). Default is gotten from version.php

USAGE:
    install-plugin-list [OPTIONS]

OPTIONS (install moodle plugin(s)):
  -f            force installation of latest available version despite lack of compatibility from maturity
  -m            minimum plugin maturity level (ex: '200'). Default 0
  -p            plugin list, separated by comma, to be installed
                Component names or HTTPS ZIP URLs are accepted

EXAMPLES:
    install-plugin-list -p 'mod_jitsi,mod_customcert,atto_multilang2'
    MOODLE_PLUGIN_LIST='mod_jitsi,mod_customcert,atto_multilang2' install-plugin-list
    install-plugin-list -p 'https://github.com/example/moodle-local_foo/archive/refs/tags/v1.0.0.zip'
EOF
}

plugin_component_from_version_php() {
    awk -F"['\"]" '/\$plugin->component[[:space:]]*=/{print $2; exit}' "$1"
}

is_zip() {
    unzip -tq "$1" >/dev/null 2>&1
}

download_zip() {
    url="$1"
    dest="$2"
    echo "Source: ${url}"
    echo "Destination: ${dest}"
    curl -fsSL --retry 3 --retry-delay 2 \
        -A "${INSTALLER_USER_AGENT}" \
        -H 'Accept: application/zip, application/octet-stream, */*' \
        -o "${dest}" "${url}"
}

# Emit candidate GitHub archive URLs for a repo+ref.
# GitHub tags vs heads differ; short /archive/<ref>.zip often works for both,
# but we try explicit refs/tags and refs/heads as well.
git_archive_urls() {
    repo="$1"
    ref="$2"
    repo="${repo%%\?*}"; repo="${repo%%#*}"; repo="${repo%/}"; repo="${repo%.git}"
    case "${repo}" in
        https://github.com/*/*)
            if [ -n "${ref}" ]; then
                printf '%s/archive/%s.zip\n' "${repo}" "${ref}"
                printf '%s/archive/refs/tags/%s.zip\n' "${repo}" "${ref}"
                printf '%s/archive/refs/heads/%s.zip\n' "${repo}" "${ref}"
            else
                printf '%s/archive/HEAD.zip\n' "${repo}"
            fi
            ;;
        *)
            return 1
            ;;
    esac
}
