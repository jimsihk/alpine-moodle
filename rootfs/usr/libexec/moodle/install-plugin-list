function emit($key, $value) {
    echo $key . '=' . str_replace(array("\n", "\r"), '', (string) $value) . "\n";
}

function http_get($url, $user_agent, $accept = 'application/json') {
    $curl = curl_init();
    curl_setopt_array($curl, array(
        CURLOPT_URL => $url,
        CURLOPT_SSL_VERIFYHOST => 2,
        CURLOPT_SSL_VERIFYPEER => true,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_USERAGENT => $user_agent,
        CURLOPT_HTTPHEADER => array('Accept: ' . $accept),
        CURLOPT_TIMEOUT => 60,
    ));
    $body = curl_exec($curl);
    $errno = curl_errno($curl);
    $code = (int) curl_getinfo($curl, CURLINFO_HTTP_CODE);
    $error = curl_error($curl);
    curl_close($curl);
    return array($body, $code, $errno, $error);
}

$params = array(
    'plugin' => $MOODLE_PLUGIN_COMPONENT_NAME,
    'minversion' => '0',
    'format' => 'json',
    'branch' => "$MOODLE_RELEASE",
);
$url = $MOODLE_API_PLUGIN_INFO . '?' . http_build_query($params);
list($raw, $http_code, $errno, $error) = http_get($url, $INSTALLER_USER_AGENT);

if ($errno) {
    file_put_contents("php://stderr", "ERROR: curl errno ({$errno}): {$error}\n");
    exit(1);
}
if ($http_code !== 200) {
    file_put_contents("php://stderr", "ERROR: Plugin info request failed for [{$MOODLE_PLUGIN_COMPONENT_NAME}] (HTTP {$http_code}).\n");
    exit(1);
}

$response = json_decode($raw);
if (!is_object($response) || (isset($response->status) && $response->status !== 'OK') || empty($response->pluginfo)) {
    file_put_contents("php://stderr", "ERROR: No plugin info for [{$MOODLE_PLUGIN_COMPONENT_NAME}].\n");
    exit(1);
}

$pluginfo = $response->pluginfo;
$version = isset($pluginfo->version) ? $pluginfo->version : null;
if (!is_object($version)) {
    file_put_contents("php://stderr", "ERROR: No plugin version info for [{$MOODLE_PLUGIN_COMPONENT_NAME}].\n");
    exit(1);
}

$parts = explode('_', $MOODLE_PLUGIN_COMPONENT_NAME, 2);
