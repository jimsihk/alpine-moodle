$moodle_plugin_name = isset($parts[1]) ? $parts[1] : '';
$install_path = install_path($MOODLE_APP, $moodle_plugin_type, $moodle_plugin_name);

$downloadurl = isset($version->downloadurl) ? (string) $version->downloadurl : '';
$downloadmd5 = isset($version->downloadmd5) ? (string) $version->downloadmd5 : '';
$source = '';
if (!empty($version->vcsrepositoryurl)) {
    $source = (string) $version->vcsrepositoryurl;
} elseif (!empty($pluginfo->source)) {
    $source = (string) $pluginfo->source;
}
$vcstag = '';
if (!empty($version->vcstag)) {
    $vcstag = (string) $version->vcstag;
} elseif (!empty($version->vcsbranch)) {
    $vcstag = (string) $version->vcsbranch;
}

# Prefer the unauthenticated Marketplace download API over login-walled HTML links.
if ($downloadurl !== '' && preg_match('#/plugins/[0-9]+/versions/[0-9]+/download#', $downloadurl)) {
    if (!empty($version->version)) {
        $downloadurl = 'https://marketplace.moodle.com/api/plugins/' . rawurlencode($MOODLE_PLUGIN_COMPONENT_NAME) . '/versions/' . rawurlencode((string) $version->version) . '/download';
    }
}

$maturity = isset($version->maturity) ? (int) $version->maturity : 0;
$supported = isset($version->supportedmoodles) && is_array($version->supportedmoodles) ? $version->supportedmoodles : array();

if (!$to_be_installed) {
    $releases = array();
    foreach ($supported as $item) {
        if (is_object($item) && isset($item->release)) {
            $releases[] = (string) $item->release;
        } elseif (is_array($item) && isset($item['release'])) {
            $releases[] = (string) $item['release'];
        }
    }
    if (!in_array($MOODLE_RELEASE, $releases, true)) {
        file_put_contents("php://stderr", "ERROR: Versions available for [{$MOODLE_PLUGIN_COMPONENT_NAME}] are not compatible with moodle release: " . $MOODLE_RELEASE . "\n");
        exit(1);
    }
    if ($maturity < $MOODLE_PLUGIN_MATURITY) {
        file_put_contents("php://stderr", "ERROR: Maturity level of version available for [{$MOODLE_PLUGIN_COMPONENT_NAME}] is below: " . $MOODLE_PLUGIN_MATURITY . "\n");
        exit(1);
    }
}

emit('downloadurl', $downloadurl);
emit('downloadmd5', $downloadmd5);
emit('installpath', $install_path);
emit('source', $source);
emit('vcstag', $vcstag);
exit(0);
?>
