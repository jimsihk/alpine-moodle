#!/bin/bash -eu
# Description: install Moodle plugin(s) from the Moodle Marketplace by component name.
#
# The Marketplace API is used for both version discovery and ZIP download. An optional
# Docker BuildKit secret named MOODLE_MARKETPLACE_TOKEN is read from
# /run/secrets/MOODLE_MARKETPLACE_TOKEN for paid plugins. The token is never copied into
# the image, written to the source tree, passed on the command line, or printed.

MARKETPLACE_PLUGIN_DOWNLOADER=/usr/libexec/moodle/marketplace-plugin-download.php

usage() {
    cat 1>&2 <<EOF2
Script to install Moodle plugin(s) by component name (ex. 'mod_jitsi').
It requires PHP cli, PHP cURL and unzip.

ENVIRONMENT VARS:
MOODLE_APP                  path to Moodle code
MOODLE_PLUGIN_LIST          plugin list separated by comma or space
MOODLE_RELEASE              Moodle release (ex: '5.0'). Default is read from version.php
MOODLE_MARKETPLACE_TOKEN_FILE
                            optional path to the Marketplace API token secret
                            (default: /run/secrets/MOODLE_MARKETPLACE_TOKEN)

USAGE:
    install-plugin-list [OPTIONS]

OPTIONS:
  -f            force installation of the latest Marketplace version regardless of
                Moodle compatibility or maturity
  -m            minimum plugin maturity level (50=alpha, 100=beta, 150=rc, 200=stable)
  -p            plugin list, separated by comma, to be installed
EOF2
}

install_path() {
    local plugin_type=$1
    local plugin_name=$2
    local plugin_dir

    declare -A dirs=(
        [tinymce]='lib/editor/tinymce/plugins'
        [tiny]='lib/editor/tiny/plugins'
        [workshopallocation]='mod/workshop/allocation'
        [atto]='lib/editor/atto/plugins'
        [availability]='availability/condition'
        [assignsubmission]='mod/assign/submission'
        [logstore]='admin/tool/log/store'
        [quizaccess]='mod/quiz/accessrule'
        [assignment]='mod/assignment/type'
        [assignfeedback]='mod/assign/feedback'
        [gradingform]='grade/grading/form'
        [qbehaviour]='question/behaviour'
        [profilefield]='user/profile/field'
        [workshopform]='mod/workshop/form'
        [workshopeval]='mod/workshop/eval'
        [scormreport]='mod/scorm/report'
        [fileconverter]='files/converter'
        [qformat]='question/format'
        [quiz]='mod/quiz/report'
        [ltiservice]='mod/lti/service'
        [datapreset]='mod/data/preset'
        [ltisource]='mod/lti/source'
        [datafield]='mod/data/field'
        [message]='message/output'
        [booktool]='mod/book/tool'
        [calendartype]='calendar/type'
        [format]='course/format'
        [coursereport]='course/report'
        [mlbackend]='lib/mlbackend'
        [search]='search/engine'
        [antivirus]='lib/antivirus'
        [qtype]='question/type'
        [media]='media/player'
        [cachestore]='cache/stores'
        [gradereport]='grade/report'
        [gradeimport]='grade/import'
        [gradeexport]='grade/export'
        [mnetservice]='mnet/service'
        [cachelock]='cache/locks'
        [plagiarism]='plagiarism'
        [repository]='repository'
        [tool]='admin/tool'
        [editor]='lib/editor'
        [dataformat]='dataformat'
        [webservice]='webservice'
        [portfolio]='portfolio'
        [filter]='filter'
        [report]='report'
        [block]='blocks'
        [local]='local'
        [enrol]='enrol'
        [theme]='theme'
        [auth]='auth'
        [mod]='mod'
    )

    plugin_dir=${dirs[$plugin_type]:-}
    if [ -z "$plugin_dir" ]; then
        >&2 echo "ERROR: ${plugin_type} is not a valid Moodle plugin type."
        exit 1
    fi
    printf '%s/%s/%s\n' "${MOODLE_APP:-/var/www/html}" "$plugin_dir" "$plugin_name"
}

install_plugin() {
    local component=$1
    local plugin_type plugin_name destination tmp_parent zip_file extracted_root

    plugin_type=${component%%_*}
    plugin_name=${component#*_}
    if [ "$plugin_type" = "$component" ] || [ -z "$plugin_name" ]; then
        >&2 echo "ERROR: Invalid Moodle plugin component: ${component}"
        exit 1
    fi

    destination=$(install_path "$plugin_type" "$plugin_name")
    tmp_parent="/tmp/moodle-plugins/${component}"
    zip_file="${tmp_parent}/${component}.zip"
    mkdir -p "$tmp_parent"

    echo "Installing plugin: ${component}..."
    echo "Downloading from Moodle Marketplace..."
    rm -f "$zip_file"
    php "$MARKETPLACE_PLUGIN_DOWNLOADER" \
        "$component" \
        "${MOODLE_RELEASE}" \
        "${script_moodle_plugin_maturity}" \
        "${script_moodle_plugin_force}" \
        "$zip_file"

    if [ ! -s "$zip_file" ]; then
        >&2 echo "ERROR: Moodle Marketplace returned an empty plugin archive for ${component}."
        exit 1
    fi
    if ! unzip -tq "$zip_file" >/dev/null; then
        >&2 echo "ERROR: Moodle Marketplace returned an invalid ZIP archive for ${component}."
        exit 1
    fi

    rm -rf "${tmp_parent}/extracted"
    mkdir -p "${tmp_parent}/extracted"
    unzip -q "$zip_file" -d "${tmp_parent}/extracted"
    extracted_root=$(find "${tmp_parent}/extracted" -mindepth 1 -maxdepth 1 -type d -print -quit)
    if [ -z "$extracted_root" ] || [ ! -f "${extracted_root}/version.php" ]; then
        >&2 echo "ERROR: ${component} archive does not contain a valid top-level version.php."
        exit 1
    fi
    if ! grep -Eq "[\\$]plugin[[:space:]]*->[[:space:]]*component[[:space:]]*=[[:space:]]*['\"]${component}['\"]" "${extracted_root}/version.php"; then
        >&2 echo "ERROR: ${component} archive version.php does not declare component ${component}."
        exit 1
    fi

    if [ -d "$destination" ]; then
        local backup_dir="${tmp_parent}/backup"
        rm -rf "$backup_dir"
        mkdir -p "$backup_dir"
        echo "Destination directory already exists: ${destination}"
        echo "Moving it to: ${backup_dir}"
        mv "$destination" "$backup_dir/"
    fi

    mkdir -p "$(dirname "$destination")"
    echo "Installing to: ${destination}"
    mv "$extracted_root" "$destination"
}

moodle_plugin_list=${MOODLE_PLUGIN_LIST:-}
script_moodle_plugin_force=
script_moodle_plugin_maturity=0

while getopts ":fp:m:" opt; do
    case ${opt} in
        f) script_moodle_plugin_force="true" ;;
        p) moodle_plugin_list="${OPTARG}" ;;
        m) script_moodle_plugin_maturity="${OPTARG}" ;;
        \?) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if (( OPTIND == 1 )); then
    echo -e "No check. Use an option:\n"
    usage
    exit 0
fi

if [ -z "${moodle_plugin_list}" ]; then
    >&2 echo "ERROR: No plugin list set."
    usage
    exit 1
fi

if [ -z "${MOODLE_RELEASE:-}" ]; then
    # Derive the release from the Moodle stable branch (e.g. MOODLE_500_STABLE -> 5.0).
    # This avoids depending on version.php after the source cleanup step.
    case "${MOODLE_GIT_BRANCH:-}" in
        MOODLE_[0-9][0-9][0-9]_STABLE)
            branch_version=${MOODLE_GIT_BRANCH#MOODLE_}
            MOODLE_RELEASE="${branch_version:0:1}.${branch_version:1:2}"
            ;;
    esac
fi
if [ -z "${MOODLE_RELEASE:-}" ]; then
    >&2 echo "ERROR: Unable to determine Moodle release."
    exit 1
fi
export MOODLE_RELEASE

IFS=',' read -r -a comma_plugins <<< "${moodle_plugin_list// /,}"
for plugin in "${comma_plugins[@]}"; do
    [ -n "$plugin" ] && install_plugin "$plugin"
done
