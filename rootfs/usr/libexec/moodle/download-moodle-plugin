#!/bin/sh
#
# Moodle code plugin installation wrapper script
# Install compatible plugins normally and only explicitly listed plugins forcibly.

UTL_PATH=/usr/libexec/moodle

if [ -n "${MOODLE_PLUGIN_LIST:-}" ]; then
  "$UTL_PATH"/install-plugin-list -p "${MOODLE_PLUGIN_LIST}"
  status=$?
  if [ "$status" -ne 0 ]; then
    exit 3
  fi
fi

# Force is scoped to this separate list; the normal plugin list is never affected.
if [ -n "${MOODLE_PLUGIN_LIST_FORCE:-}" ]; then
  "$UTL_PATH"/install-plugin-list -f -p "${MOODLE_PLUGIN_LIST_FORCE}"
  status=$?
  if [ "$status" -ne 0 ]; then
    exit 2
  fi
fi

rm -rf /tmp/moodle-plugins
